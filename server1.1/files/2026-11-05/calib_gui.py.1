# ============================ 摄像头后台线程 ============================
class CameraWorker(threading.Thread):
    """后台持续读帧并识别标签，主界面只取最新结果。"""
    """
"buzzer": {
        "default_ms": 150,
        "default_hz": 1200
    }
    """
    def __init__(self, index=1):
        super().__init__(daemon=True)
        self.index = index        # 摄像头编号
        self.lock = threading.Lock()
        self.frame = None          # 最新一帧（彩色 BGR）
        self.tags = []             # 最新一帧识别到的标签
        self.active = False        # 线程是否在运行
        self.error = None          # 启动失败原因

    def start_camera(self, index):
        """用指定编号启动采集线程（已在运行则忽略）。"""

        if self.active:
            return
        self.index = index
        self.error = None
        self.active = True
        super().start()

    def stop_camera(self):
        """请求停止采集线程。"""

        self.active = False

    def snapshot(self):
        """取最新一帧和标签的副本。"""

        with self.lock:
            if self.frame is None:
                return None, []
            return self.frame.copy(), list(self.tags)

    def run(self):
        """线程主体：开摄像头 → 循环读帧识别 → 退出时释放。"""

        try:
            camera = vision.open_camera(self.index)
            detector = vision.create_detector()
        except Exception as exc:
            self.error = str(exc)
            self.active = False
            return
        while self.active:
            frame, tags = vision.read_tags(camera, detector)
            with self.lock:
                self.frame = frame
                self.tags = tags
        camera.release()
        with self.lock:
            self.frame = None
            self.tags = []


# ============================ 主界面 ============================
class CalibApp:
    """主控配置界面。"""
    def beep(self):
        """短促蜂鸣一声（使用SD指令）"""
        ms = self.config["buzzer"]["default_ms"]
        hz = self.config["buzzer"]["default_hz"]
        if board.is_connected():
            try:
                board.buzzer_sd(ms, hz)
            except Exception:
                pass

    def buzzer_sd_trigger(self):
        """SD [ms][Hz] 蜂鸣指令，读取UI参数下发"""
        ms = self.get_int(self.buzzer_ms_var, "蜂鸣时长ms")
        hz = self.get_int(self.buzzer_hz_var, "蜂鸣频率Hz")
        if ms is None or hz is None:
            return
        if ms <= 0 or hz <= 0:
            self.log("蜂鸣时长、频率必须大于0！")
            return
        if self._safe(board.buzzer_sd, ms, hz):
            self.log(f"下发蜂鸣 SD {ms} {hz}")


    def _safe_save_config(self):
        """安全保存配，捕获IO异常，修复保存失败无提示"""
        try:
            config_io._safe_save_config(self.config)
            return True
        except Exception as e:
            messagebox.showerror("配置保存失败", f"写入 targets_config.json 失败：{e}")
            self.log(f"【ERROR】保存JSON失败：{e}")
            return False

    def __init__(self, root):
        self.root = root
        root.title("打靶主控配置界面")
        root.minsize(1330, 760)          # 自适应：允许拉伸，只限最小尺寸
        root.geometry("1420x920")
        root.protocol("WM_DELETE_WINDOW", self.on_closing)

        config_existed = os.path.exists(config_io.CONFIG_PATH)
        self.config = config_io.load_config()   # 缺失/损坏时自动创建
        self.worker = CameraWorker()

        # 自动搜索状态
        self.auto_mode = MODE_MANUAL
        self.auto_tag = None       # 正在追踪的标签编号
        self.centered = 0          # 连续居中帧数
        self.last_speed = 0        # 上次下发的云台速度

        # 实时偏差：当前追踪标签中心相对摄像头中心的横向像素
        self.live_tag = None
        self.live_error = None

        # ========== 新增：1/2/3标签识别计时缓存 key=tag_id ==========
        self.tag_detect_cache = {}   # {tag_id: {"detect_ts": 时间戳, "detect_angle": 识别时舵机角度}}

        # 全局变量
        self.servo_var = tk.IntVar(value=self.config["servo"]["default_angle"])
        self.gimbal_speed_var = tk.IntVar(value=150)   # 云台手动速度
        self.laser_on = False
        # ========== 新增蜂鸣器参数 ==========
        self.buzzer_ms_var = tk.IntVar(value=self.config["buzzer"]["default_ms"])
        self.buzzer_hz_var = tk.IntVar(value=self.config["buzzer"]["default_hz"])


        self._build_layout()
        self._bind_keys()
        self.log("界面已就绪。先【连接控制板】，检测并选择摄像头后【开始搜索】。")
        if not config_existed:
            self.log(f"未找到配置文件，已自动创建默认配置：{config_io.CONFIG_PATH}")
        self.root.after(UI_INTERVAL_MS, self._tick)
        self.root.after(300, self.scan_cameras)   # 启动时自动扫描摄像头

    # ---------- 界面布局 ----------
    def _build_layout(self):
        """单屏三列布局，避免切换页签。"""

        top = ttk.Frame(self.root)
        top.pack(fill="both", expand=True, padx=8, pady=4)

        # 布局：左列摄像头固定 640px 宽（16:9 不被压缩），
        # 右侧分两个栏目：① 操控（舵机/云台/发射） ② 配置（靶点/全局）
        top.columnconfigure(0, weight=0, minsize=640)
        top.columnconfigure(1, weight=1)
        top.columnconfigure(2, weight=2, minsize=440)
        top.rowconfigure(0, weight=1)

        # 左列：摄像头预览（固定宽度，随高度等比缩放）
        left = ttk.Frame(top)
        left.grid(row=0, column=0, sticky="nsew")
        self.canvas = tk.Canvas(left, width=640, height=360,
                                bg="black", highlightthickness=0)
        self.canvas.pack(fill="both", expand=True)
        self.status_var = tk.StringVar(value="摄像头未打开")
        ttk.Label(left, textvariable=self.status_var).pack(anchor="w")
        self._build_serial_panel(left)
        self._build_auto_panel(left)

        # 栏目① 操控
        mid = ttk.LabelFrame(top, text="栏目① 操控（舵机 / 云台 / 发射）")
        mid.grid(row=0, column=1, sticky="nsew", padx=(8, 0))
        self._build_servo_panel(mid)
        self._build_gimbal_panel(mid)
        self._build_mech_panel(mid)

        # 栏目② 配置
        right = ttk.LabelFrame(top, text="栏目② 配置（靶点 / 全局参数）")
        right.grid(row=0, column=2, sticky="nsew", padx=(8, 0))
        self._build_targets_panel(right)
        self._build_global_panel(right)

        self.log_text = scrolledtext.ScrolledText(self.root, height=7,
                                                  state="disabled")
        self.log_text.pack(fill="both", padx=8, pady=4)

