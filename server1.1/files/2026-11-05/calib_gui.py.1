    def scan_cameras(self):
        """后台扫描可用摄像头编号，填入下拉框。"""

        if getattr(self, "_scanning", False):
            return
        self._scanning = True
        self.camera_combo.configure(values=[self.camera_var.get()])
        self.log("正在扫描摄像头…")

        def worker():
            found = []
            for index in range(6):
                cap = cv2.VideoCapture(index, cv2.CAP_DSHOW)
                if cap.isOpened():
                    found.append(str(index))
                cap.release()
            self.root.after(0, self._scan_done, found)

        threading.Thread(target=worker, daemon=True).start()

    def _scan_done(self, found):
        """扫描结束：更新下拉框并提示。"""

        self._scanning = False
        if found:
            self.camera_combo.configure(values=found)
            if self.camera_var.get() not in found:
                self.camera_var.set(found[0])
            self.log(f"检测到摄像头: {', '.join(found)}")
        else:
            self.log("未检测到可用摄像头，请检查连接。")

